DATABASE_URL=postgres://postgres:development_only@localhost:5432/tiket_development
JWT_SECRET=replace_with_a_random_secret
PORT=3001
HOST=127.0.0.1
DEBUG=false
FRONTEND_URL=http://localhost:3000
CDN_URL=http://localhost:3001

# Platform Razorpay account. Use separate environments/databases/secrets for test and live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ACCOUNT_ID=

# Pricing is exclusive and per ticket. All fees/taxes default to zero.
PRICING_POLICY_VERSION=zero-v1
TICKET_TAX_BPS=0
PLATFORM_FEE_BPS=0
PLATFORM_FEE_PAISE=0
FEE_TAX_BPS=0

# Platform mail sender. Organizer overrides are encrypted with a 32-byte hex key.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Tiket
CREDENTIAL_ENCRYPTION_KEY=

# Private R2 bucket, with browser PUT CORS configured for the frontend origin.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
