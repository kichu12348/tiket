{
  "name": "tiket-backend",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "author": {
    "name": "Mahadevan Reji"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:push": "bun --bun drizzle-kit push --config ./drizzle.config.ts",
    "db:migrate": "bun --bun drizzle-kit migrate --config ./drizzle.config.ts",
    "db:studio": "bun --bun drizzle-kit studio --config ./drizzle.config.ts",
    "db:init": "bun db:generate && bun db:push",
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "db:reset:dev": "bun src/scripts/reset-development.ts --confirm-development-reset"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.20.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "@aws-sdk/s3-request-presigner": "^3.1153.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.0",
    "@fastify/websocket": "^11.3.4",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "nodemailer": "^10.1.7",
    "razorpay": "^2.9.8",
    "sanitize-html": "^2.18.1",
    "uuid": "^14.0.1"
  }
}
